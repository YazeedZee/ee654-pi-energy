# Input videos: large, tracked by checksum only
data/inputs/*
!data/inputs/README.md
!data/inputs/SHA256SUMS
!data/inputs/SOURCES.sha256

# Detector model files: fetched by scripts/fetch_model.sh, verified by checksum
pipeline/models/

# Media and disk images anywhere
*.mp4
*.mkv
*.h264
*.yuv
*.img
*.img.zst

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# LaTeX build files
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/paper_draft_*.pdf
paper/*_arxiv.tar.gz

# Editors / OS
.vscode/
*.swp
.DS_Store
